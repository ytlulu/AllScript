        local ok, s = pcall(function() return HttpService:JSONDecode(raw) end)
        if not ok or not s then return end
        if s.kgMany        then kgMany        = s.kgMany        end
        if s.kgTargetBase  then kgTargetBase  = s.kgTargetBase  end
        if s.kgByStep     ~= nil then kgByStep     = s.kgByStep     end
        if s.showInfo     ~= nil then showInfo     = s.showInfo     end
        if s.detailInfo   ~= nil then detailInfo   = s.detailInfo   end
        if s.showPanelProgress ~= nil then showPanelProgress = s.showPanelProgress end
        if s.showPanelBlessing ~= nil then showPanelBlessing = s.showPanelBlessing end
        if s.showPanelPnp      ~= nil then showPanelPnp      = s.showPanelPnp      end
        if s.showPanelAllProg  ~= nil then showPanelAllProg  = s.showPanelAllProg  end
        if s.lvMany        then lvMany        = s.lvMany        end
        if s.lvTargetAge   then lvTargetAge   = s.lvTargetAge   end
        if s.lvFromKG     ~= nil then lvFromKG     = s.lvFromKG     end
        if s.pnpDelayPick  then pnpDelayPick  = s.pnpDelayPick  end
        if s.pnpDelayPlace then pnpDelayPlace = s.pnpDelayPlace end
        if s.pnpSync      ~= nil then pnpSync      = s.pnpSync      end
        if s.webhookUrl    then webhookUrl    = s.webhookUrl    end
        if s.webhookKG    ~= nil then webhookKG    = s.webhookKG    end
        if s.webhookLV    ~= nil then webhookLV    = s.webhookLV    end
        if s.boostSelectedUUIDs and type(s.boostSelectedUUIDs) == "table" then
            boostSavedUUIDs = s.boostSelectedUUIDs
        end
        if s.boostToyMode then boostToyMode = s.boostToyMode end
        -- [CHANGE 1] load boostDelayMin dan update BOOST_DURATION
        if s.boostDelayMin then
            boostDelayMin  = s.boostDelayMin
