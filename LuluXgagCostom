-- ============================================================
-- SCAN
-- ============================================================
local function scanAll()
    allPets       = {}
    allDisplay    = {}
    equippedUUIDs = {}
    bagUUIDs      = {}

    for _, item in ipairs(Backpack:GetChildren()) do
        pcall(function()
            if not isOwnedByLP(item) then return end
            if item:GetAttribute("PetType") == "Pet" then
                local uuid    = item:GetAttribute("PET_UUID") or item.Name
                local petName = item:GetAttribute("f") or ""
                local parsed  = parseName(item.Name)
                bagUUIDs[uuid] = true
                if parsed.kg then kgLastKnown[uuid] = tonumber(parsed.kg) or 0 end
                table.insert(allPets, {
                    uuid     = uuid,
                    name     = petName,
                    kg       = parsed.kg,
                    age      = parsed.age,
                    display  = buildDisplay(petName, parsed.kg, parsed.age),
                    equipped = false,
                })
            end
        end)
    end

    -- FIX 2: build UUID index O(1) lookup, ganti inner loop O(n²)
    local uuidIndex = {}
    for i, p in ipairs(allPets) do uuidIndex[p.uuid] = i end

    pcall(function()
        for _, child in ipairs(getPetDisplay():GetChildren()) do
            if child:IsA("Frame") and child:FindFirstChild("Main") then
                local m    = child.Main
                local uuid = child.Name
                equippedUUIDs[uuid] = true
                local petName = m:FindFirstChild("PET_NAME") and m.PET_NAME.Text or ""
                local petAge  = readPetAge(m)
                local petType = m:FindFirstChild("PET_TYPE") and m.PET_TYPE.Text or ""
                local disp    = petName
                              .. (petAge > 0 and (" [Age " .. petAge .. "]") or "")
                              .. " [★]"
                local existingIdx = uuidIndex[uuid]
                if existingIdx then
                    allPets[existingIdx] = {
                        uuid     = uuid,
                        name     = petName,
                        petType  = petType,
                        kg       = nil,
                        age      = tostring(petAge),
                        display  = disp,
                        equipped = true,
                    }
                else
                    table.insert(allPets, {
                        uuid     = uuid,
                        name     = petName,
                        petType  = petType,
                        kg       = nil,
                        age      = tostring(petAge),
                        display  = disp,
                        equipped = true,
                    })
                    uuidIndex[uuid] = #allPets
                end
            end
        end
    end)

    table.sort(allPets, function(a, b) return a.name:lower() < b.name:lower() end)
    for _, p in ipairs(allPets) do table.insert(allDisplay, p.display) end

    uuidToName  = {}
    allPetNames = {}
    local nameSet = {}
    for _, p in ipairs(allPets) do
        uuidToName[p.uuid] = p.name
        if p.name ~= "" and not nameSet[p.name] then
            nameSet[p.name] = true
            table.insert(allPetNames, p.name)
        end
    end
    table.sort(allPetNames)

    displayToPet = {}
    uuidToType   = {}
    for _, p in ipairs(allPets) do
        displayToPet[p.display] = p
        if p.petType and p.petType ~= "" then
            uuidToType[p.uuid] = p.petType
        end
    end
end

