lvStartLoop = function()
    if LV.Thread then pcall(function() task.cancel(LV.Thread) end) end
    LV.Thread = task.spawn(function()
        unequipAllActive()

        local queue = {}
        for _, dn in ipairs(LV.Targets) do
            local p = petOf(dn); if p then table.insert(queue, p) end
        end

        local active = {}
        local qi = 1
        local function pickNext()
            while qi <= #queue do
                local p = queue[qi]; qi = qi + 1
                if LV.Status[p.uuid] ~= "done" then return p end
            end
            return nil
        end

        while #active < LV.Many do
            local nxt = pickNext(); if not nxt then break end
            LV.Status[nxt.uuid] = "progres"
            table.insert(active, {
                uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
            })
            equipPet(nxt.uuid); task.wait(0.4)
        end

        equipList(LV.Lv1)

        while LV.Running do
            task.wait(1)

            local i = 1
            while i <= #active do
                local t   = active[i]
                local age = getAge(t.uuid)

                if t.phase == "lv1" and age >= 40 and #LV.Lv2 > 0 then
                    t.phase = "lv2"
                    switchList(LV.Lv1, LV.Lv2)
                    task.spawn(function() notifyPetLVPhase(t.name, age, "lv2") end)

                elseif age >= LV.TargetAge then
                    LV.Status[t.uuid]    = "done"
                    LV.DoneUUIDs[t.uuid] = true
                    rebuildLVTargetDisplay()
                    unequipPet(t.uuid); task.wait(0.3)

                    local lvDoneCount = 0
                    for _ in pairs(LV.DoneUUIDs) do lvDoneCount = lvDoneCount + 1 end
                    task.spawn(function() notifyPetLVDone(t.name, age, lvDoneCount, #LV.Targets) end)

                    local nxt = pickNext()
                    if nxt then
                        LV.Status[nxt.uuid] = "progres"
                        active[i] = {
                            uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                        }
                        if t.phase == "lv2" then
                            switchList(LV.Lv2, LV.Lv1)
                        end
                        equipPet(nxt.uuid); task.wait(0.4)
                    else
                        table.remove(active, i)
                        continue
                    end
                end

                i = i + 1
            end

            if #active == 0 then break end

            local lvAdded = false
            while #active < LV.Many do
                local nxt = pickNext(); if not nxt then break end
                LV.Status[nxt.uuid] = "progres"
                table.insert(active, {
                    uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                })
                equipPet(nxt.uuid); task.wait(0.4)
                lvAdded = true
            end
            if lvAdded then equipList(LV.Lv1) end
        end

        for _, t in ipairs(active) do pcall(function() unequipPet(t.uuid) end) end

        if LV.Running then
            LV.Running = false
            LV.AllDone = true
            unequipAllActive()
            task.wait(0.5)
            refreshTargets()
            pcall(function() if tglLVStart then tglLVStart:SetState(false) end end)
            win:luluNotify("All Your Pets Success Leveling to Age " .. LV.TargetAge .. "!", "success")
            if Webhook.LV then
                task.spawn(function() notifyAllLVDone() end)
            end
        end
    end)
end

