local function doScanBoostPets()
    boostScanMap  = {}
    boostDisplays = {}
    pcall(function()
        local seen = {}
        local i    = 0
        for _, child in ipairs(getPetDisplay():GetChildren()) do
            if child:IsA("Frame") and child:FindFirstChild("Main") then
                i = i + 1
                local m         = child.Main
                local petName   = m:FindFirstChild("PET_NAME") and m.PET_NAME.Text or ""
                local petType   = m:FindFirstChild("PET_TYPE") and m.PET_TYPE.Text or ""
                local base
                if petName ~= "" and petType ~= "" then
                    base = petName .. " [" .. petType .. "]"
                elseif petName ~= "" then
                    base = petName
                elseif petType ~= "" then
                    base = petType
                else
                    base = "Pet #" .. i
                end
                local key = base
                local n   = 2
                while seen[key] do key = base .. " (" .. n .. ")"; n = n + 1 end
                seen[key]         = true
                boostScanMap[key] = child.Name
                table.insert(boostDisplays, key)
            end
        end
    end)
    return #boostDisplays
end

local function startBoostLoop()
    boostThread = task.spawn(function()
        while boostRunning do
            task.wait(TICK)
            if not boostRunning then break end

            local useSmall  = (boostToyMode == "Small"  or boostToyMode == "Both")
            local useMedium = (boostToyMode == "Medium" or boostToyMode == "Both")

            for uuid, timers in pairs(boostTimers) do
                if not boostRunning then break end

                if useSmall then
                    timers.st = timers.st - TICK
                    if timers.st <= 0 then
                        if findBoostTool("Small") then
                            timers.st = BOOST_DURATION
                            pcall(function() applyOneToy(uuid, "Small") end)
                        else
                            timers.st = 0
                        end
                    end
                end

                if useMedium then
                    timers.mt = timers.mt - TICK
                    if timers.mt <= 0 then
                        if findBoostTool("Medium") then
                            timers.mt = BOOST_DURATION
                            pcall(function() applyOneToy(uuid, "Medium") end)
                        else
                            timers.mt = 0
                        end
                    end
                end
            end
        end
        boostThread = nil
    end)
end

