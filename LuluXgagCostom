local function applyOneToy(uuid, toyType)
    local tool = findBoostTool(toyType)
    if not tool then return false end
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    pcall(function()
        hum:EquipTool(tool)
        task.wait(0.3)
        ReplicatedStorage.GameEvents.PetBoostService:FireServer("ApplyBoost", uuid)
        task.wait(0.3)
        hum:UnequipTools()
        task.wait(0.3)
    end)
    return true
end

