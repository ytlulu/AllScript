local function triggerLVAfterKG()
    task.wait(0.5)
    -- FIX: jangan scanAll() di sini — pakai allPets & displayToPet yg udah ada
    -- scanAll() bisa rebuild displayToPet dengan key baru yg ga match kgDoneUUIDs
    local seen, merged = {}, {}
    for _, dn in ipairs(lvManualTargets) do
        local p = petOf(dn)
        if p and not seen[p.uuid] then
            seen[p.uuid] = true; table.insert(merged, dn)
        end
    end
    if lvFromKG then
        for uuid in pairs(kgDoneUUIDs) do
            if not seen[uuid] then
                seen[uuid] = true
                for _, p in ipairs(allPets) do
                    if p.uuid == uuid then table.insert(merged, p.display); break end
                end
            end
        end
    end
    lvTargets = merged
    lvStatus  = {}
    lvDoneUUIDs = {}
    for _, dn in ipairs(lvTargets) do
        local p = petOf(dn)
        if p then lvStatus[p.uuid] = "waiting" end
    end
    if #lvTargets == 0 then
        win:luluNotify("LV: tidak ada target — pilih pet di dropdown atau aktifkan Auto Select KG", "warning")
        lvRunning = false
        pcall(function() if tglLVStart then tglLVStart:SetState(false) end end)
    else
        -- set toggle LV ON secara visual (karena user aktifkan dari standby)
        pcall(function() if tglLVStart then tglLVStart:SetState(true) end end)
        win:luluNotify("KG Done → LV Started! (" .. #lvTargets .. " pets)", "success")
        task.spawn(function() notifyLVStarted(lvTargets, lvTargetAge) end)
        lvStartLoop()
    end
end

local function kgStartLoop()
    if kgThread then pcall(function() task.cancel(kgThread) end) end
    kgActivePhases = {}

    kgThread = task.spawn(function()
        unequipAllActive()

        -- Kalau LV dalam standby mode (lvWaitingForKG), update list dengan LV+KG targets
        if lvWaitingForKG then
            local seen, merged = {}, {}
            for _, dn in ipairs(lvManualTargets) do
                local p = petOf(dn)
                if p and not seen[p.uuid] then seen[p.uuid] = true; table.insert(merged, dn) end
            end
            for _, dn in ipairs(kgTargets) do
                local p = petOf(dn)
                if p and not seen[p.uuid] then seen[p.uuid] = true; table.insert(merged, dn) end
            end
            lvTargets   = merged
            lvStatus    = {}
            lvDoneUUIDs = {}
            for _, dn in ipairs(lvTargets) do
                local p = petOf(dn); if p then lvStatus[p.uuid] = "waiting" end
            end
            win:luluNotify(
                "KG Started → LV Standby update: " .. #lvTargets .. " pets (LV + KG list)",
                "info"
            )
        end

        local queue = {}
        for _, dn in ipairs(kgTargets) do
            local p = petOf(dn); if p then table.insert(queue, p) end
        end

        if #queue == 0 then
            kgRunning = false
            pcall(function() if tglKGStart then tglKGStart:SetState(false) end end)
            win:luluNotify("Tidak ada target KG — pilih pet dulu!", "warning")
            return
        end

        local active     = {}
        local upkgQueue  = {}
        local upkgSlot   = nil
        local upkgChecks = {}
        local requeue    = {}
        -- counter urutan pet masuk leveling (untuk notif "pet ke-N dari total")
        local kgPetCounter = 0
        local kgTotalQueue = #queue

        local qi = 1
        local function pickNext()
            while qi <= #queue do
                local p = queue[qi]; qi = qi + 1
                if kgStatus[p.uuid] ~= "done" and kgStatus[p.uuid] ~= "waiting_kg" then
                    return p
                end
            end
            if #requeue > 0 then
                queue = requeue; requeue = {}; qi = 1
                kgPetCounter = 0       -- reset counter: cycle baru mulai dari 1/..
                kgTotalQueue = #queue  -- update total sesuai requeue
                return pickNext()
            end
            return nil
        end

        local function checkAllHelpersFired()
            if #jumboLabelOrder == 0 then return false end
            for _, uuid in ipairs(jumboLabelOrder) do
                if not jumboFiredPerHelper[uuid] then return false end
            end
            return true
        end

        local function resetHelperFiredStatus()
            for _, uuid in ipairs(jumboLabelOrder) do
                jumboFiredPerHelper[uuid] = nil
            end
        end

        local function startNextUpkg(keepHelper)
            if upkgSlot or #upkgQueue == 0 then return end
            upkgSlot = table.remove(upkgQueue, 1)
            resetHelperFiredStatus()
            kgStatus[upkgSlot.uuid]       = "progres"
            kgActivePhases[upkgSlot.uuid] = "upkg"
            equipPet(upkgSlot.uuid); task.wait(0.4)
            if not keepHelper then equipList(kgUpKG) end
        end

        local function finalizeUpkgBatch()
            unequipAllActive(); task.wait(0.8)
            -- [CHANGE 2] Reset ✓ saat batch baru dimulai agar tidak carry-over ke pet berikutnya
            resetHelperFiredStatus()

            for _, checked in ipairs(upkgChecks) do
                local prevKG  = kgCurrentKG[checked.uuid] or kgLastKnown[checked.uuid] or 0
                local finalKG = nil
                for _ = 1, 5 do
                    local scan = rescanPetTarget(checked.uuid)
                    if scan.kg > 0 then
                        finalKG = scan.kg
                        kgCurrentKG[checked.uuid] = finalKG
                        break
                    end
                    task.wait(1)
                end
                if finalKG == nil then
                    finalKG = kgLastKnown[checked.uuid] or 0
                    kgCurrentKG[checked.uuid] = finalKG
                end
                task.spawn(function() notifyPetKGUpdate(checked.name, prevKG, finalKG) end)

                if kgTargetBase == 0 or finalKG >= kgTargetBase then
                    kgStatus[checked.uuid]       = "done"
                    kgDoneUUIDs[checked.uuid]    = checked.name or ""
                    kgActivePhases[checked.uuid] = nil
                    task.spawn(function() notifyPetKGDone(checked.name, finalKG) end)
                else
                    kgStatus[checked.uuid]       = "waiting"
                    kgActivePhases[checked.uuid] = nil
                    table.insert(requeue, {
                        uuid = checked.uuid, display = checked.display, name = checked.name
                    })
                end
            end
            upkgChecks = {}
            rebuildKGTargetDisplay()

            -- Step mode (kgByStep=ON): langsung isi slot yang kosong
            -- Batch mode (kgByStep=OFF): biarkan bottom loop yang isi setelah active & upkg benar-benar habis
            if kgByStep then
                while #active < kgMany do
                    local nxt = pickNext(); if not nxt then break end
                    kgPetCounter = kgPetCounter + 1
                    kgStatus[nxt.uuid]       = "progres"
                    kgActivePhases[nxt.uuid] = "lv1"
                    table.insert(active, {
                        uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                    })
                    -- [CHANGE 3] Notif webhook saat pet mulai leveling (di finalizeUpkgBatch)
                    task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
                    equipPet(nxt.uuid); task.wait(0.4)
                end

                if #active > 0 then
                    local hasLv2 = false
                    for _, a in ipairs(active) do if a.phase == "lv2" then hasLv2 = true end end
                    equipList(hasLv2 and kgLv2 or kgLv1)
                end
            end
        end

        -- Initial fill
        while #active < kgMany do
            local nxt = pickNext(); if not nxt then break end
            kgPetCounter = kgPetCounter + 1
            kgStatus[nxt.uuid]       = "progres"
            kgActivePhases[nxt.uuid] = "lv1"
            table.insert(active, {
                uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
            })
            -- [CHANGE 3] Notif webhook saat pet pertama kali masuk leveling
            task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
            equipPet(nxt.uuid); task.wait(0.4)
        end

        equipList(kgLv1)

        while kgRunning do
            task.wait(1)

            if upkgSlot then
                local targetAge = getAge(upkgSlot.uuid)
                if targetAge == 1 then
                    local savedSlot = upkgSlot
                    unequipPet(savedSlot.uuid); task.wait(0.8)

                    local prevKGSlot = kgCurrentKG[savedSlot.uuid] or kgLastKnown[savedSlot.uuid] or 0
                    local finalKG    = nil
                    local preKG      = kgLastKnown[savedSlot.uuid] or 0
                    for _ = 1, 5 do
                        local scan = rescanPetTarget(savedSlot.uuid)
                        if scan.kg > 0 then
                            finalKG = scan.kg
                            kgCurrentKG[savedSlot.uuid] = finalKG
                            break
                        end
                        task.wait(1)
                    end
                    if finalKG == nil then
                        finalKG = preKG
                        kgCurrentKG[savedSlot.uuid] = finalKG
                    end
                    task.spawn(function() notifyPetKGUpdate(savedSlot.name, prevKGSlot, finalKG) end)

                    if kgTargetBase == 0 then
                        kgStatus[savedSlot.uuid]       = "done"
                        kgDoneUUIDs[savedSlot.uuid]    = savedSlot.name or ""
                        kgActivePhases[savedSlot.uuid] = nil
                        task.spawn(function() notifyPetKGDone(savedSlot.name, finalKG) end)
                    elseif finalKG >= kgTargetBase then
                        kgStatus[savedSlot.uuid]       = "done"
                        kgDoneUUIDs[savedSlot.uuid]    = savedSlot.name or ""
                        kgActivePhases[savedSlot.uuid] = nil
                        task.spawn(function() notifyPetKGDone(savedSlot.name, finalKG) end)
                    else
                        kgStatus[savedSlot.uuid]       = "waiting"
                        kgActivePhases[savedSlot.uuid] = nil
                        table.insert(requeue, {
                            uuid = savedSlot.uuid, display = savedSlot.display, name = savedSlot.name
                        })
                    end

                    resetHelperFiredStatus()
                    upkgSlot = nil
                    rebuildKGTargetDisplay()

                    if #upkgQueue > 0 then
                        startNextUpkg(true)
                    else
                        finalizeUpkgBatch()
                    end

                elseif checkAllHelpersFired() then
                    resetHelperFiredStatus()
                    unequipPet(upkgSlot.uuid); task.wait(0.3)
                    kgActivePhases[upkgSlot.uuid] = "check"
                    table.insert(upkgChecks, upkgSlot)
                    upkgSlot = nil

                    if #upkgQueue > 0 then
                        startNextUpkg(true)
                    else
                        finalizeUpkgBatch()
                    end
                end
            end

            local i = 1
            while i <= #active do
                local t   = active[i]
                local age = getAge(t.uuid)

                if t.phase == "lv1" then
                    if age >= 30 and #kgLv2 > 0 then
                        t.phase                = "lv2"
                        kgActivePhases[t.uuid] = "lv2"
                        switchList(kgLv1, kgLv2)

                    elseif age >= 50 then
                        kgLastKnownAge[t.uuid]   = age
                        kgStatus[t.uuid]         = "waiting_kg"
                        kgActivePhases[t.uuid]   = "upkg_wait"
                        unequipPet(t.uuid); task.wait(0.3)
                        table.insert(upkgQueue, {
                            uuid = t.uuid, display = t.display, name = t.name
                        })
                        table.remove(active, i)

                        local needLv1 = false
                        for _, a in ipairs(active) do
                            if a.phase == "lv1" then needLv1 = true; break end
                        end
                        if not needLv1 then unequipList(kgLv1) end

                        if kgByStep then
                            local nxt = pickNext()
                            if nxt then
                                kgPetCounter = kgPetCounter + 1
                                kgStatus[nxt.uuid]       = "progres"
                                kgActivePhases[nxt.uuid] = "lv1"
                                table.insert(active, {
                                    uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                                })
                                -- [CHANGE 3] Notif webhook kgByStep lv1
                                task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
                                equipPet(nxt.uuid); task.wait(0.4)
                                equipList(kgLv1)
                            end
                        end
                        continue
                    end

                elseif t.phase == "lv2" then
                    if age >= 50 then
                        kgLastKnownAge[t.uuid]   = age
                        kgStatus[t.uuid]         = "waiting_kg"
                        kgActivePhases[t.uuid]   = "upkg_wait"
                        unequipPet(t.uuid); task.wait(0.3)
                        table.insert(upkgQueue, {
                            uuid = t.uuid, display = t.display, name = t.name
                        })
                        table.remove(active, i)

                        local needLv2 = false
                        for _, a in ipairs(active) do
                            if a.phase == "lv2" then needLv2 = true; break end
                        end
                        if not needLv2 then unequipList(kgLv2) end

                        if kgByStep then
                            local nxt = pickNext()
                            if nxt then
                                kgPetCounter = kgPetCounter + 1
                                kgStatus[nxt.uuid]       = "progres"
                                kgActivePhases[nxt.uuid] = "lv1"
                                table.insert(active, {
                                    uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                                })
                                -- [CHANGE 3] Notif webhook kgByStep lv2→lv1 baru
                                task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
                                equipPet(nxt.uuid); task.wait(0.4)
                                equipList(kgLv1)
                            end
                        end
                        continue
                    end
                end

                i = i + 1
            end

            if #active == 0 and not upkgSlot and #upkgQueue > 0 then
                startNextUpkg(false)
            end

            if not upkgSlot and #upkgQueue == 0 then
                -- Step mode: isi kapanpun ada slot kosong
                -- Batch mode: isi HANYA kalau seluruh batch sudah selesai (active=0 & upkgChecks=0)
                local canFill = kgByStep or (#active == 0 and #upkgChecks == 0)
                if canFill then
                    local added = false
                    while #active < kgMany do
                        local nxt = pickNext(); if not nxt then break end
                        kgPetCounter = kgPetCounter + 1
                        kgStatus[nxt.uuid]       = "progres"
                        kgActivePhases[nxt.uuid] = "lv1"
                        table.insert(active, {
                            uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                        })
                        -- [CHANGE 3] Notif webhook bottom-loop fill
                        task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
                        equipPet(nxt.uuid); task.wait(0.4)
                        added = true
                    end
                    if added then equipList(kgLv1) end
                end
            end

            if #active == 0 and not upkgSlot
               and #upkgQueue == 0 and #upkgChecks == 0 and #requeue == 0 then
                break
            end
        end

        kgActivePhases = {}
        for _, t in ipairs(active) do pcall(function() unequipPet(t.uuid) end) end
        if upkgSlot then pcall(function() unequipPet(upkgSlot.uuid) end) end

        if kgRunning then
            kgRunning = false
            kgAllDone = true
            unequipAllActive()
            task.wait(0.5)
            -- FIX: jangan refreshTargets/rebuildLV di sini — reset list & bentrok sama LV
            kgThread = nil
            -- FIX: set flag supaya SetState(false) di bawah ga trigger stop-callback
            kgCompletedNaturally = true
            pcall(function() if tglKGStart then tglKGStart:SetState(false) end end)
            win:luluNotify("Automatelly Up Kg Done All Done", "success")
            if webhookKG then
                sendWebhookEmbed({
                    title       = "Automatelly Up KG Done!",
                    description = "Semua **" .. #kgTargets .. " pets** selesai Up KG.",
                    color       = 0x57F287,
                    footer      = { text = "LuluXGAG " .. SCRIPT_VERSION },
                    timestamp   = os.date("!%Y-%m-%dT%H:%M:%S"),
                })
            end
            if lvFromKG or lvWaitingForKG then
                -- KG selesai → aktifkan LV (baik dari standby maupun dari trigger langsung)
                lvWaitingForKG = false
                if not lvRunning then
                    lvRunning = true
                    lvAllDone = false
                end
                task.spawn(triggerLVAfterKG)
            end
        end
    end)
end

