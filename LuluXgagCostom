        if s.spiderToggle    ~= nil then spiderToggle    = s.spiderToggle    end
        if s.petsToggle      ~= nil then petsToggle      = s.petsToggle      end
        if s.spottedToggle   ~= nil then spottedToggle   = s.spottedToggle   end
    end)
end

