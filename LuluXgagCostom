-- ============================================================
-- JUMBO BLESSING TRACKER
-- ============================================================
local jumboBlessings      = {}
local jumboFiredPerHelper = {}
local jumboLabelOrder     = {}
local jumboLabelSet       = {}
local jumboLastSeen       = {}

-- ============================================================
-- PetCooldownsUpdated – Jumbo Blessing + PnP
-- ============================================================
if PnP.CDConn then pcall(function() PnP.CDConn:Disconnect() end) end
PnP.CDConn = PetCooldownsUpdated.OnClientEvent:Connect(function(uuid, data)
    uuid = uuid or "unknown"
    local foundJumbo = false

    for _, skill in ipairs(data) do
        if skill.Passive == "Jumbo Blessing" then
            local prev = jumboBlessings[uuid] and jumboBlessings[uuid].time
            local cur  = tonumber(skill.Time) or 0
            if prev ~= nil and cur > prev then jumboFiredPerHelper[uuid] = true end
            if not jumboLabelSet[uuid] then
                jumboLabelSet[uuid] = true
                table.insert(jumboLabelOrder, uuid)
            end
            jumboBlessings[uuid] = { time = cur }
            jumboLastSeen[uuid]  = tick()   -- FIX 4: was boost.TICK()
            foundJumbo = true
        end
    end

    -- PnP On Skill
    if PnP.Running and PnP.OnSkillUUIDs[uuid] then
        local firstSkill = data and data[1]
        if firstSkill then
            local cd = tonumber(firstSkill.Time) or 0
            PnP.Status[uuid]   = { skill = firstSkill.Passive, cd = cd }
            PnP.LastSeen[uuid] = tick()   -- FIX 4
            if not PnP.LabelSet[uuid] then
                PnP.LabelSet[uuid] = true
                table.insert(PnP.LabelOrder, uuid)
            end
            if cd == 0 and not PnP.Processing[uuid] then
                if PnP.Sync and (
                    KG.Status[uuid] == "progres" or KG.ActivePhases[uuid] ~= nil or
                    LV.Status[uuid] == "progres"
                ) then
                else
                    PnP.Processing[uuid] = true
                    task.spawn(function()
                        local function cleanup() PnP.Processing[uuid] = nil end
                        local syncBudget = 10
                        if PnP.Sync then
                            while PnP.SyncPaused and syncBudget > 0 do
                                task.wait(0.5); syncBudget = syncBudget - 0.5
                            end
                        end
                        if not PnP.Running then cleanup(); return end
                        local ok, frame = pcall(function() return getPetDisplay():FindFirstChild(uuid) end)
                        if not ok or not frame then cleanup(); return end
                        task.wait(PnP.DelayPick)
                        if not PnP.Running or not PnP.OnSkillUUIDs[uuid] then cleanup(); return end
                        if PnP.Sync then
                            while PnP.SyncPaused and syncBudget > 0 do
                                task.wait(0.5); syncBudget = syncBudget - 0.5
                            end
                        end
                        if not PnP.Running or not PnP.OnSkillUUIDs[uuid] then cleanup(); return end
                        pcall(function() unequipPet(uuid) end)
                        task.wait(PnP.DelayPlace)
                        pcall(function() equipPet(uuid) end)
                        cleanup()
                    end)
                end
            end
        end
    end

    -- PnP After Skill
    if PnP.Running and PnP.AfterSkillUUIDs[uuid] then
        local firstSkill = data and data[1]
        if firstSkill then
            local cd     = tonumber(firstSkill.Time) or 0
            local prevCD = PnP.PrevCD[uuid]
            PnP.PrevCD[uuid]   = cd
            PnP.Status[uuid]   = { skill = firstSkill.Passive, cd = cd }
            PnP.LastSeen[uuid] = tick()   -- FIX 4
            if not PnP.LabelSet[uuid] then
                PnP.LabelSet[uuid] = true
                table.insert(PnP.LabelOrder, uuid)
            end
            if (prevCD or 0) == 0 and cd > 0 and not PnP.Processing[uuid] then
                if PnP.Sync and (
                    KG.Status[uuid] == "progres" or KG.ActivePhases[uuid] ~= nil or
                    LV.Status[uuid] == "progres"
                ) then
                else
                    PnP.Processing[uuid] = true
                    task.spawn(function()
                        local function cleanup() PnP.Processing[uuid] = nil end
                        local syncBudget = 10
                        if PnP.Sync then
                            while PnP.SyncPaused and syncBudget > 0 do
                                task.wait(0.5); syncBudget = syncBudget - 0.5
                            end
                        end
                        if not PnP.Running then cleanup(); return end
                        local ok, frame = pcall(function() return getPetDisplay():FindFirstChild(uuid) end)
                        if not ok or not frame then cleanup(); return end
                        task.wait(PnP.DelayPick)
                        if not PnP.Running or not PnP.AfterSkillUUIDs[uuid] then cleanup(); return end
                        if PnP.Sync then
                            while PnP.SyncPaused and syncBudget > 0 do
                                task.wait(0.5); syncBudget = syncBudget - 0.5
                            end
                        end
                        if not PnP.Running or not PnP.AfterSkillUUIDs[uuid] then cleanup(); return end
                        pcall(function() unequipPet(uuid) end)
                        task.wait(PnP.DelayPlace)
                        pcall(function() equipPet(uuid) end)
                        cleanup()
                    end)
                end
            end
        end
    end

    if not foundJumbo then
        if jumboBlessings[uuid] then
            for i, u in ipairs(jumboLabelOrder) do
                if u == uuid then table.remove(jumboLabelOrder, i); break end
            end
        end
        jumboBlessings[uuid]      = nil
        jumboFiredPerHelper[uuid] = nil
        jumboLabelSet[uuid]       = nil
    end
end)

