lvStartLoop = function()
    if lvThread then pcall(function() task.cancel(lvThread) end) end
    lvThread = task.spawn(function()
        unequipAllActive()

        local queue = {}
        for _, dn in ipairs(lvTargets) do
            local p = petOf(dn); if p then table.insert(queue, p) end
        end

        local active = {}
        local qi = 1
        local function pickNext()
            while qi <= #queue do
                local p = queue[qi]; qi = qi + 1
                if lvStatus[p.uuid] ~= "done" then return p end
            end
            return nil
        end

        while #active < lvMany do
            local nxt = pickNext(); if not nxt then break end
            lvStatus[nxt.uuid] = "progres"
            table.insert(active, {
                uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
            })
            equipPet(nxt.uuid); task.wait(0.4)
        end

        equipList(lvLv1)

        while lvRunning do
            task.wait(1)

            local i = 1
            while i <= #active do
                local t   = active[i]
                local age = getAge(t.uuid)

                if t.phase == "lv1" and age >= 40 and #lvLv2 > 0 then
                    t.phase = "lv2"
                    switchList(lvLv1, lvLv2)
                    task.spawn(function() notifyPetLVPhase(t.name, age, "lv2") end)

                elseif age >= lvTargetAge then
                    lvStatus[t.uuid]    = "done"
                    lvDoneUUIDs[t.uuid] = true
                    rebuildLVTargetDisplay()
                    unequipPet(t.uuid); task.wait(0.3)

                    local lvDoneCount = 0
                    for _ in pairs(lvDoneUUIDs) do lvDoneCount = lvDoneCount + 1 end
                    task.spawn(function() notifyPetLVDone(t.name, age, lvDoneCount, #lvTargets) end)

                    local nxt = pickNext()
                    if nxt then
                        lvStatus[nxt.uuid] = "progres"
                        active[i] = {
                            uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                        }
                        if t.phase == "lv2" then
                            switchList(lvLv2, lvLv1)
                        end
                        equipPet(nxt.uuid); task.wait(0.4)
                    else
                        table.remove(active, i)
                        continue
                    end
                end

                i = i + 1
            end

            if #active == 0 then break end

            local lvAdded = false
            while #active < lvMany do
                local nxt = pickNext(); if not nxt then break end
                lvStatus[nxt.uuid] = "progres"
                table.insert(active, {
                    uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                })
                equipPet(nxt.uuid); task.wait(0.4)
                lvAdded = true
            end
            if lvAdded then equipList(lvLv1) end
        end

        for _, t in ipairs(active) do pcall(function() unequipPet(t.uuid) end) end

        if lvRunning then
            lvRunning = false
            lvAllDone = true
            unequipAllActive()
            task.wait(0.5)
            refreshTargets()
            -- set toggle LV OFF secara visual
            pcall(function() if tglLVStart then tglLVStart:SetState(false) end end)
            win:luluNotify("All Your Pets Success Leveling to Age " .. lvTargetAge .. "!", "success")
            if webhookLV then
                task.spawn(function() notifyAllLVDone() end)
            end
        end
    end)
end

