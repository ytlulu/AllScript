                if KG.Running then
                    local seenKG = {}
                    for _, dn in ipairs(LV.Targets) do
                        local p = petOf(dn); if p then seenKG[p.uuid] = true end
                    end
                    for _, dn in ipairs(KG.Targets) do
                        local p = petOf(dn)
