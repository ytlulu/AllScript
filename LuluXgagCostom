-- ============================================================
-- JUMBO BLESSING TRACKER
-- ============================================================
local jumboBlessings      = {}
local jumboFiredPerHelper = {}
local jumboLabelOrder     = {}
local jumboLabelSet       = {}
local jumboLastSeen       = {}
local pnpLastSeen         = {}

-- ============================================================
-- PetCooldownsUpdated – Jumbo Blessing + PnP
-- ============================================================
-- FIX 5: disconnect dulu agar tidak duplikat saat re-inject
if petCDConn then pcall(function() petCDConn:Disconnect() end) end
petCDConn = PetCooldownsUpdated.OnClientEvent:Connect(function(uuid, data)
    uuid = uuid or "unknown"
    local foundJumbo = false

    for _, skill in ipairs(data) do
        if skill.Passive == "Jumbo Blessing" then
            local prev = jumboBlessings[uuid] and jumboBlessings[uuid].time
            local cur  = tonumber(skill.Time) or 0
            if prev ~= nil and cur > prev then jumboFiredPerHelper[uuid] = true end
            if not jumboLabelSet[uuid] then
                jumboLabelSet[uuid] = true
                table.insert(jumboLabelOrder, uuid)
            end
            jumboBlessings[uuid] = { time = cur }
            jumboLastSeen[uuid]  = tick()
            foundJumbo = true
        end
    end

    -- PnP On Skill
    if pnpRunning and pnpOnSkillUUIDs[uuid] then
        local firstSkill = data and data[1]
        if firstSkill then
            local cd = tonumber(firstSkill.Time) or 0
            pnpStatus[uuid]   = { skill = firstSkill.Passive, cd = cd }
            pnpLastSeen[uuid] = tick()
            if not pnpLabelSet[uuid] then
                pnpLabelSet[uuid] = true
                table.insert(pnpLabelOrder, uuid)
            end
            if cd == 0 and not pnpProcessing[uuid] then
                if pnpSync and (
                    kgStatus[uuid] == "progres" or kgActivePhases[uuid] ~= nil or
                    lvStatus[uuid] == "progres"
                ) then
                else
                    pnpProcessing[uuid] = true
                    task.spawn(function()
                        local function cleanup() pnpProcessing[uuid] = nil end
                        local syncBudget = 10
                        if pnpSync then
                            while pnpSyncPaused and syncBudget > 0 do
                                task.wait(0.5); syncBudget = syncBudget - 0.5
                            end
                        end
                        if not pnpRunning then cleanup(); return end
                        local ok, frame = pcall(function() return getPetDisplay():FindFirstChild(uuid) end)
                        if not ok or not frame then cleanup(); return end
                        task.wait(pnpDelayPick)
                        if not pnpRunning or not pnpOnSkillUUIDs[uuid] then cleanup(); return end
                        if pnpSync then
                            while pnpSyncPaused and syncBudget > 0 do
                                task.wait(0.5); syncBudget = syncBudget - 0.5
                            end
                        end
                        if not pnpRunning or not pnpOnSkillUUIDs[uuid] then cleanup(); return end
                        pcall(function() unequipPet(uuid) end)
                        task.wait(pnpDelayPlace)
                        pcall(function() equipPet(uuid) end)
                        cleanup()
                    end)
                end
            end
        end
    end

    -- PnP After Skill
    if pnpRunning and pnpAfterSkillUUIDs[uuid] then
        local firstSkill = data and data[1]
        if firstSkill then
            local cd     = tonumber(firstSkill.Time) or 0
            local prevCD = pnpPrevCD[uuid]
            pnpPrevCD[uuid] = cd
            pnpStatus[uuid]   = { skill = firstSkill.Passive, cd = cd }
            pnpLastSeen[uuid] = tick()
            if not pnpLabelSet[uuid] then
                pnpLabelSet[uuid] = true
                table.insert(pnpLabelOrder, uuid)
            end
            if (prevCD or 0) == 0 and cd > 0 and not pnpProcessing[uuid] then
                if pnpSync and (
                    kgStatus[uuid] == "progres" or kgActivePhases[uuid] ~= nil or
                    lvStatus[uuid] == "progres"
                ) then
                else
                    pnpProcessing[uuid] = true
                    task.spawn(function()
                        local function cleanup() pnpProcessing[uuid] = nil end
                        local syncBudget = 10
                        if pnpSync then
                            while pnpSyncPaused and syncBudget > 0 do
                                task.wait(0.5); syncBudget = syncBudget - 0.5
                            end
                        end
                        if not pnpRunning then cleanup(); return end
                        local ok, frame = pcall(function() return getPetDisplay():FindFirstChild(uuid) end)
                        if not ok or not frame then cleanup(); return end
                        task.wait(pnpDelayPick)
                        if not pnpRunning or not pnpAfterSkillUUIDs[uuid] then cleanup(); return end
                        if pnpSync then
                            while pnpSyncPaused and syncBudget > 0 do
                                task.wait(0.5); syncBudget = syncBudget - 0.5
                            end
                        end
                        if not pnpRunning or not pnpAfterSkillUUIDs[uuid] then cleanup(); return end
                        pcall(function() unequipPet(uuid) end)
                        task.wait(pnpDelayPlace)
                        pcall(function() equipPet(uuid) end)
                        cleanup()
                    end)
                end
            end
        end
    end

    if not foundJumbo then
        if jumboBlessings[uuid] then
            for i, u in ipairs(jumboLabelOrder) do
                if u == uuid then table.remove(jumboLabelOrder, i); break end
            end
        end
        jumboBlessings[uuid]      = nil
        jumboFiredPerHelper[uuid] = nil
        jumboLabelSet[uuid]       = nil
    end
end)

