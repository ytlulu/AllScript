local grpAllProgress = info:Group(); grpAllProgress:Hide()
local grpKalc        = info:Group(); grpKalc:Hide()
local grpKalcRange   = info:Group(); grpKalcRange:Hide()

local AUTOHIDE_TIMEOUT = 3
local PRUNE_TIMEOUT    = 30

task.spawn(function()
    while true do
        task.wait(1)
        pcall(function()
            local now = tick()   -- FIX 4: was boost.TICK()

            local newJumboOrder = {}
            for _, uuid in ipairs(jumboLabelOrder) do
                if jumboLastSeen[uuid] and (now - jumboLastSeen[uuid]) < PRUNE_TIMEOUT then
                    table.insert(newJumboOrder, uuid)
                else
                    jumboBlessings[uuid]      = nil
                    jumboFiredPerHelper[uuid]  = nil
                    jumboLastSeen[uuid]        = nil
                    jumboLabelSet[uuid]        = nil
                end
            end
            jumboLabelOrder = newJumboOrder

            local newPnpOrder = {}
            for _, uuid in ipairs(PnP.LabelOrder) do
                if PnP.LastSeen[uuid] and (now - PnP.LastSeen[uuid]) < PRUNE_TIMEOUT then
                    table.insert(newPnpOrder, uuid)
                else
                    PnP.Status[uuid]     = nil
                    PnP.LastSeen[uuid]   = nil
                    PnP.LabelSet[uuid]   = nil
                    PnP.PrevCD[uuid]     = nil
                    PnP.Processing[uuid] = nil
                end
            end
            PnP.LabelOrder = newPnpOrder

            if not State.ShowInfo then
                info:Hide()
                return
            end
            info:Show()

            local activePets = getActivePets()
            local activeMap  = {}
            for _, ap in ipairs(activePets) do
                activeMap[ap.uuid] = ap
                if ap.type and ap.type ~= "" then
                    State.UUIDToType[ap.uuid] = ap.type
                end
            end

            local targets, statusMap
            if KG.Running then
                targets   = KG.Targets
                statusMap = KG.Status
            elseif LV.Running then
                targets   = LV.Targets
                statusMap = LV.Status
            elseif LV.WaitingForKG then
                targets   = LV.Targets
                statusMap = LV.Status
            elseif KG.AllDone then
                targets   = KG.Targets
                statusMap = KG.Status
            elseif LV.AllDone then
                targets   = LV.Targets
                statusMap = LV.Status
            else
                targets   = {}
                statusMap = {}
            end

            local cntProgres, cntWaiting, cntDone = 0, 0, 0
            for _, dn in ipairs(targets) do
                local p = petOf(dn); if not p then continue end
                local st = statusMap[p.uuid] or "waiting"
                if st == "progres" or st == "waiting_kg" then
                    cntProgres = cntProgres + 1
                elseif st == "waiting" then
                    cntWaiting = cntWaiting + 1
                else
                    cntDone = cntDone + 1
                end
            end

            local modeName
            if KG.Running          then modeName = "Automatelly Up KG"
            elseif LV.Running      then modeName = "Automatelly Leveling"
            elseif LV.WaitingForKG then modeName = "LV Standby (tunggu KG)"
            elseif KG.AllDone      then modeName = "Up KG Done"
            elseif LV.AllDone      then modeName = "Leveling Done"
            end

            local jumboCount = 0
            for _, uuid in ipairs(jumboLabelOrder) do
                if jumboLastSeen[uuid] and (now - jumboLastSeen[uuid]) < AUTOHIDE_TIMEOUT then
                    jumboCount = jumboCount + 1
                end
            end

            local pnpCount = 0
            for _, uuid in ipairs(PnP.LabelOrder) do
                if PnP.LastSeen[uuid] and (now - PnP.LastSeen[uuid]) < AUTOHIDE_TIMEOUT then
                    pnpCount = pnpCount + 1
                end
            end

            -- COMPACT MODE
            if not State.DetailInfo then
                if State.ShowProgress and modeName and #targets > 0 then
                    grpOnProgress:Show()
                    grpOnProgress:Clear()
                    grpOnProgress:Header("On Progres")
                    grpOnProgress:QuestLine("Mode",    modeName)
                    grpOnProgress:QuestLine("Progres", tostring(cntProgres))
                    grpOnProgress:QuestLine("Waiting", tostring(cntWaiting))
                    grpOnProgress:QuestLine("Done",    tostring(cntDone))
                    if LV.WaitingForKG then
                        grpOnProgress:QuestLine("LV Standby", tostring(#LV.Targets) .. " pets")
                    end
                else
                    grpOnProgress:Hide()
                end

                if State.ShowBlessing and jumboCount > 0 then
                    grpJumbo:Show()
                    grpJumbo:Clear()
                    grpJumbo:Header("Jumbo panel")
                    grpJumbo:QuestLine("Pets", tostring(jumboCount))
                else
                    grpJumbo:Hide()
                end

                if State.ShowPnp and PnP.Running and pnpCount > 0 then
                    grpPnp:Show()
                    grpPnp:Clear()
                    grpPnp:Header("PnP panel")
                    grpPnp:QuestLine("Pets", tostring(pnpCount))
                else
                    grpPnp:Hide()
                end

                grpAllProgress:Hide()
                return
            end

            -- FULL / DETAIL MODE
            local progresItems = {}
            for _, dn in ipairs(targets) do
                local p = petOf(dn); if not p then continue end
                local st = statusMap[p.uuid] or "waiting"
                if st == "progres" then table.insert(progresItems, p) end
            end

            if State.ShowProgress and #progresItems > 0 then
                grpOnProgress:Show()
                grpOnProgress:Clear()
                grpOnProgress:Header("On Progres")
                for _, p in ipairs(progresItems) do
                    local ap    = activeMap[p.uuid]
                    local phase = KG.ActivePhases[p.uuid]
                    local petType = State.UUIDToType[p.uuid] or ""
                    local name    = petType ~= "" and petType or p.name

                    local age
                    if ap then
                        age = tostring(ap.age)
                    elseif phase == "upkg" then
                        age = tostring(KG.LastKnownAge[p.uuid] or 50)
                    else
                        age = tostring(getAge(p.uuid))
                    end

                    local baseStr
                    if KG.Running then
                        baseStr = KG.CurrentKG[p.uuid]
                            and (string.format("%.2f", KG.CurrentKG[p.uuid]) .. " KG")
                            or  "-"
                    else
                        baseStr = age .. " Age"
                    end

                    grpOnProgress:QuestLine("Name", name)
                    grpOnProgress:QuestLine("Age",  age)
                    grpOnProgress:QuestLine("Base", baseStr)
                end
            else
                grpOnProgress:Hide()
            end

            local hasActiveJumbo = jumboCount > 0
            if State.ShowBlessing and hasActiveJumbo then
                grpJumbo:Show()
                grpJumbo:Clear()
                grpJumbo:Header("Jumbo Panel")
                for _, uuid in ipairs(jumboLabelOrder) do
                    local jb = jumboBlessings[uuid]
                    if not jb then continue end
                    if not jumboLastSeen[uuid] or (now - jumboLastSeen[uuid]) >= AUTOHIDE_TIMEOUT then
                        continue
                    end
                    local petType = State.UUIDToType[uuid] or ""
                    local label   = petType ~= "" and petType or uuid:sub(1, 8)
                    local cdStr   = jb.time == 0
                        and "ready"
                        or  (tostring(jb.time) .. (jumboFiredPerHelper[uuid] and " ✓" or ""))
                    grpJumbo:QuestLine(label, cdStr)
                end
            else
                grpJumbo:Hide()
            end

            local hasActivePnp = false
            for _, uuid in ipairs(PnP.LabelOrder) do
                if PnP.LastSeen[uuid] and (now - PnP.LastSeen[uuid]) < AUTOHIDE_TIMEOUT then
                    hasActivePnp = true; break
                end
            end

            if State.ShowPnp and PnP.Running and hasActivePnp then
                grpPnp:Show()
                grpPnp:Clear()
                grpPnp:Header("PnP Panel")
                for _, uuid in ipairs(PnP.LabelOrder) do
                    local entry = PnP.Status[uuid]
                    if not entry then continue end
                    if not PnP.LastSeen[uuid] or (now - PnP.LastSeen[uuid]) >= AUTOHIDE_TIMEOUT then
                        continue
                    end
                    local petType = State.UUIDToType[uuid] or ""
                    local label   = petType ~= "" and petType or uuid:sub(1, 8)
                    grpPnp:QuestLine(label, entry.cd == 0 and "ready" or tostring(entry.cd))
                end
            else
                grpPnp:Hide()
            end

            local function sortOrder(st)
                if st == "progres"        then return 1
                elseif st == "waiting_kg" then return 2
                elseif st == "waiting"    then return 3
                else                           return 4
                end
            end

            if State.ShowAllProg and #targets > 0 then
                local snapParts = {}
                for _, dn in ipairs(targets) do
                    local p = petOf(dn); if not p then continue end
                    local st = statusMap[p.uuid] or "waiting"
                    local extra = ""
                    if st == "progres" and KG.Running then
                        local kg = KG.CurrentKG[p.uuid]
                        if kg then extra = string.format("%.1f", kg) end
                    end
                    snapParts[#snapParts + 1] = p.uuid .. st .. extra
                end
                local lvStandby = LV.WaitingForKG and tostring(#LV.Targets) or ""
                local snapshot  = table.concat(snapParts, "|") .. lvStandby

                if snapshot ~= State.AllProgLastStatus then
                    State.AllProgLastStatus = snapshot

                    grpAllProgress:Show()
                    grpAllProgress:Clear()
                    grpAllProgress:Header("All Progress")

                    local sorted = {}
                    for _, dn in ipairs(targets) do
                        local p = petOf(dn); if not p then continue end
                        local st = statusMap[p.uuid] or "waiting"
                        table.insert(sorted, { p = p, st = st, order = sortOrder(st) })
                    end
                    table.sort(sorted, function(a, b) return a.order < b.order end)

                    for _, item in ipairs(sorted) do
                        local p  = item.p
                        local st = item.st
                        local petType = State.UUIDToType[p.uuid] or ""
                        local label   = petType ~= "" and petType or p.name

                        local valueStr
                        if st == "progres" then
                            if KG.Running then
                                local kg = KG.CurrentKG[p.uuid]
                                valueStr = "on progres"
                                    .. (kg and (" [" .. string.format("%.2f", kg) .. " KG]") or "")
                            else
                                local ap  = activeMap[p.uuid]
                                local age = ap and tostring(ap.age) or tostring(getAge(p.uuid))
                                valueStr  = "on progres [Age " .. age .. "]"
                            end
                        elseif st == "waiting_kg" then
                            valueStr = "waiting KG"
                        elseif st == "waiting" then
                            valueStr = "waiting..."
                        else
                            if KG.Running or KG.AllDone then
                                local kg = KG.CurrentKG[p.uuid] or KG.LastKnown[p.uuid]
                                valueStr = "Done [" .. (kg and string.format("%.2f", kg) or "?") .. " KG]"
                            else
                                valueStr = "Done [Age " .. LV.TargetAge .. "]"
                            end
                        end

                        grpAllProgress:QuestLine(label, valueStr)
                    end

                    if LV.WaitingForKG then
                        grpAllProgress:Divider()
                        grpAllProgress:QuestLine("LV Standby", #LV.Targets .. " pets (tunggu KG)")
                    end
                end
            else
                grpAllProgress:Hide()
                State.AllProgLastStatus = ""
            end
        end)
    end
end)

