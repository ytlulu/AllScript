-- ============================================================
-- AUTO KG – LOOP
-- ============================================================
local lvStartLoop

local function triggerLVAfterKG()
    task.wait(0.5)
    local seen, merged = {}, {}
    for _, dn in ipairs(LV.ManualTargets) do
        local p = petOf(dn)
        if p and not seen[p.uuid] then
            seen[p.uuid] = true; table.insert(merged, dn)
        end
    end
    if LV.FromKG then
        for uuid in pairs(KG.DoneUUIDs) do
            if not seen[uuid] then
                seen[uuid] = true
                for _, p in ipairs(State.AllPets) do
                    if p.uuid == uuid then table.insert(merged, p.display); break end
                end
            end
        end
    end
    LV.Targets   = merged
    LV.Status    = {}
    LV.DoneUUIDs = {}
    for _, dn in ipairs(LV.Targets) do
        local p = petOf(dn)
        if p then LV.Status[p.uuid] = "waiting" end
    end
    if #LV.Targets == 0 then
        win:luluNotify("LV: tidak ada target — pilih pet di dropdown atau aktifkan Auto Select KG", "warning")
        LV.Running = false
        pcall(function() if tglLVStart then tglLVStart:SetState(false) end end)
    else
        pcall(function() if tglLVStart then tglLVStart:SetState(true) end end)
        win:luluNotify("KG Done → LV Started! (" .. #LV.Targets .. " pets)", "success")
        task.spawn(function() notifyLVStarted(LV.Targets, LV.TargetAge) end)
        lvStartLoop()
    end
end

local function kgStartLoop()
    -- FIX 5: KG.Thread (kapital), bukan kG.Thread
    if KG.Thread then pcall(function() task.cancel(KG.Thread) end) end
    KG.ActivePhases = {}

    KG.Thread = task.spawn(function()
        unequipAllActive()

        if LV.WaitingForKG then
            local seen, merged = {}, {}
            for _, dn in ipairs(LV.ManualTargets) do
                local p = petOf(dn)
                if p and not seen[p.uuid] then seen[p.uuid] = true; table.insert(merged, dn) end
            end
            for _, dn in ipairs(KG.Targets) do
                local p = petOf(dn)
                if p and not seen[p.uuid] then seen[p.uuid] = true; table.insert(merged, dn) end
            end
            LV.Targets   = merged
            LV.Status    = {}
            LV.DoneUUIDs = {}
            for _, dn in ipairs(LV.Targets) do
                local p = petOf(dn); if p then LV.Status[p.uuid] = "waiting" end
            end
            win:luluNotify(
                "KG Started → LV Standby update: " .. #LV.Targets .. " pets (LV + KG list)",
                "info"
            )
        end

        local queue = {}
        for _, dn in ipairs(KG.Targets) do
            local p = petOf(dn); if p then table.insert(queue, p) end
        end

        if #queue == 0 then
            KG.Running = false
            pcall(function() if tglKGStart then tglKGStart:SetState(false) end end)
            win:luluNotify("Tidak ada target KG — pilih pet dulu!", "warning")
            return
        end

        local active     = {}
        local upkgQueue  = {}
        local upkgSlot   = nil
        local upkgChecks = {}
        local requeue    = {}
        local kgPetCounter = 0
        local kgTotalQueue = #queue

        local qi = 1
        local function pickNext()
            while qi <= #queue do
                local p = queue[qi]; qi = qi + 1
                if KG.Status[p.uuid] ~= "done" and KG.Status[p.uuid] ~= "waiting_kg" then
                    return p
                end
            end
            if #requeue > 0 then
                queue = requeue; requeue = {}; qi = 1
                kgPetCounter = 0
                kgTotalQueue = #queue
                return pickNext()
            end
            return nil
        end

        local function checkAllHelpersFired()
            if #jumboLabelOrder == 0 then return false end
            for _, uuid in ipairs(jumboLabelOrder) do
                if not jumboFiredPerHelper[uuid] then return false end
            end
            return true
        end

        local function resetHelperFiredStatus()
            for _, uuid in ipairs(jumboLabelOrder) do
                jumboFiredPerHelper[uuid] = nil
            end
        end

        local function startNextUpkg(keepHelper)
            if upkgSlot or #upkgQueue == 0 then return end
            upkgSlot = table.remove(upkgQueue, 1)
            resetHelperFiredStatus()
            KG.Status[upkgSlot.uuid]       = "progres"
            KG.ActivePhases[upkgSlot.uuid] = "upkg"
            equipPet(upkgSlot.uuid); task.wait(0.4)
            if not keepHelper then equipList(KG.UpKG) end
        end

        local function finalizeUpkgBatch()
            unequipAllActive(); task.wait(0.8)
            resetHelperFiredStatus()

            for _, checked in ipairs(upkgChecks) do
                local prevKG  = KG.CurrentKG[checked.uuid] or KG.LastKnown[checked.uuid] or 0
                local finalKG = nil
                for _ = 1, 5 do
                    local scan = rescanPetTarget(checked.uuid)
                    if scan.kg > 0 then
                        finalKG = scan.kg
                        KG.CurrentKG[checked.uuid] = finalKG
                        break
                    end
                    task.wait(1)
                end
                if finalKG == nil then
                    finalKG = KG.LastKnown[checked.uuid] or 0
                    KG.CurrentKG[checked.uuid] = finalKG
                end
                task.spawn(function() notifyPetKGUpdate(checked.name, prevKG, finalKG) end)

                if KG.TargetBase == 0 or finalKG >= KG.TargetBase then
                    KG.Status[checked.uuid]       = "done"
                    KG.DoneUUIDs[checked.uuid]    = checked.name or ""
                    KG.ActivePhases[checked.uuid] = nil
                    task.spawn(function() notifyPetKGDone(checked.name, finalKG) end)
                else
                    KG.Status[checked.uuid]       = "waiting"
                    KG.ActivePhases[checked.uuid] = nil
                    table.insert(requeue, {
                        uuid = checked.uuid, display = checked.display, name = checked.name
                    })
                end
            end
            upkgChecks = {}
            rebuildKGTargetDisplay()

            if KG.ByStep then
                while #active < KG.Many do
                    local nxt = pickNext(); if not nxt then break end
                    kgPetCounter = kgPetCounter + 1
                    KG.Status[nxt.uuid]       = "progres"
                    KG.ActivePhases[nxt.uuid] = "lv1"
                    table.insert(active, {
                        uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                    })
                    task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
                    equipPet(nxt.uuid); task.wait(0.4)
                end

                if #active > 0 then
                    local hasLv2 = false
                    for _, a in ipairs(active) do if a.phase == "lv2" then hasLv2 = true end end
                    equipList(hasLv2 and KG.Lv2 or KG.Lv1)
                end
            end
        end

        -- Initial fill
        while #active < KG.Many do
            local nxt = pickNext(); if not nxt then break end
            kgPetCounter = kgPetCounter + 1
            KG.Status[nxt.uuid]       = "progres"
            KG.ActivePhases[nxt.uuid] = "lv1"
            table.insert(active, {
                uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
            })
            task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
            equipPet(nxt.uuid); task.wait(0.4)
        end

        equipList(KG.Lv1)

        while KG.Running do
            task.wait(1)

            if upkgSlot then
                local targetAge = getAge(upkgSlot.uuid)
                if targetAge == 1 then
                    local savedSlot = upkgSlot
                    unequipPet(savedSlot.uuid); task.wait(0.8)

                    local prevKGSlot = KG.CurrentKG[savedSlot.uuid] or KG.LastKnown[savedSlot.uuid] or 0
                    local finalKG    = nil
                    local preKG      = KG.LastKnown[savedSlot.uuid] or 0
                    for _ = 1, 5 do
                        local scan = rescanPetTarget(savedSlot.uuid)
                        if scan.kg > 0 then
                            finalKG = scan.kg
                            KG.CurrentKG[savedSlot.uuid] = finalKG
                            break
                        end
                        task.wait(1)
                    end
                    if finalKG == nil then
                        finalKG = preKG
                        KG.CurrentKG[savedSlot.uuid] = finalKG
                    end
                    task.spawn(function() notifyPetKGUpdate(savedSlot.name, prevKGSlot, finalKG) end)

                    if KG.TargetBase == 0 then
                        KG.Status[savedSlot.uuid]       = "done"
                        KG.DoneUUIDs[savedSlot.uuid]    = savedSlot.name or ""
                        KG.ActivePhases[savedSlot.uuid] = nil
                        task.spawn(function() notifyPetKGDone(savedSlot.name, finalKG) end)
                    elseif finalKG >= KG.TargetBase then
                        KG.Status[savedSlot.uuid]       = "done"
                        KG.DoneUUIDs[savedSlot.uuid]    = savedSlot.name or ""
                        KG.ActivePhases[savedSlot.uuid] = nil
                        task.spawn(function() notifyPetKGDone(savedSlot.name, finalKG) end)
                    else
                        KG.Status[savedSlot.uuid]       = "waiting"
                        KG.ActivePhases[savedSlot.uuid] = nil
                        table.insert(requeue, {
                            uuid = savedSlot.uuid, display = savedSlot.display, name = savedSlot.name
                        })
                    end

                    resetHelperFiredStatus()
                    upkgSlot = nil
                    rebuildKGTargetDisplay()

                    if #upkgQueue > 0 then
                        startNextUpkg(true)
                    else
                        finalizeUpkgBatch()
                    end

                elseif checkAllHelpersFired() then
                    resetHelperFiredStatus()
                    unequipPet(upkgSlot.uuid); task.wait(0.3)
                    KG.ActivePhases[upkgSlot.uuid] = "check"
                    table.insert(upkgChecks, upkgSlot)
                    upkgSlot = nil

                    if #upkgQueue > 0 then
                        startNextUpkg(true)
                    else
                        finalizeUpkgBatch()
                    end
                end
            end

            local i = 1
            while i <= #active do
                local t   = active[i]
                local age = getAge(t.uuid)

                if t.phase == "lv1" then
                    if age >= 30 and #KG.Lv2 > 0 then
                        t.phase                = "lv2"
                        KG.ActivePhases[t.uuid] = "lv2"
                        switchList(KG.Lv1, KG.Lv2)

                    elseif age >= 50 then
                        KG.LastKnownAge[t.uuid]   = age
                        KG.Status[t.uuid]         = "waiting_kg"
                        KG.ActivePhases[t.uuid]   = "upkg_wait"
                        unequipPet(t.uuid); task.wait(0.3)
                        table.insert(upkgQueue, {
                            uuid = t.uuid, display = t.display, name = t.name
                        })
                        table.remove(active, i)

                        local needLv1 = false
                        for _, a in ipairs(active) do
                            if a.phase == "lv1" then needLv1 = true; break end
                        end
                        if not needLv1 then unequipList(KG.Lv1) end

                        if KG.ByStep then
                            local nxt = pickNext()
                            if nxt then
                                kgPetCounter = kgPetCounter + 1
                                KG.Status[nxt.uuid]       = "progres"
                                KG.ActivePhases[nxt.uuid] = "lv1"
                                table.insert(active, {
                                    uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                                })
                                task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
                                equipPet(nxt.uuid); task.wait(0.4)
                                equipList(KG.Lv1)
                            end
                        end
                        continue
                    end

                elseif t.phase == "lv2" then
                    if age >= 50 then
                        KG.LastKnownAge[t.uuid]   = age
                        KG.Status[t.uuid]         = "waiting_kg"
                        KG.ActivePhases[t.uuid]   = "upkg_wait"
                        unequipPet(t.uuid); task.wait(0.3)
                        table.insert(upkgQueue, {
                            uuid = t.uuid, display = t.display, name = t.name
                        })
                        table.remove(active, i)

                        local needLv2 = false
                        for _, a in ipairs(active) do
                            if a.phase == "lv2" then needLv2 = true; break end
                        end
                        if not needLv2 then unequipList(KG.Lv2) end

                        if KG.ByStep then
                            local nxt = pickNext()
                            if nxt then
                                kgPetCounter = kgPetCounter + 1
                                KG.Status[nxt.uuid]       = "progres"
                                KG.ActivePhases[nxt.uuid] = "lv1"
                                table.insert(active, {
                                    uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                                })
                                task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
                                equipPet(nxt.uuid); task.wait(0.4)
                                equipList(KG.Lv1)
                            end
                        end
                        continue
                    end
                end

                i = i + 1
            end

            if #active == 0 and not upkgSlot and #upkgQueue > 0 then
                startNextUpkg(false)
            end

            if not upkgSlot and #upkgQueue == 0 then
                local canFill = KG.ByStep or (#active == 0 and #upkgChecks == 0)
                if canFill then
                    local added = false
                    while #active < KG.Many do
                        local nxt = pickNext(); if not nxt then break end
                        kgPetCounter = kgPetCounter + 1
                        KG.Status[nxt.uuid]       = "progres"
                        KG.ActivePhases[nxt.uuid] = "lv1"
                        table.insert(active, {
                            uuid = nxt.uuid, display = nxt.display, name = nxt.name, phase = "lv1"
                        })
                        task.spawn(notifyPetKGLevelingSwitch, nxt.name, "lv1", kgPetCounter, kgTotalQueue)
                        equipPet(nxt.uuid); task.wait(0.4)
                        added = true
                    end
                    if added then equipList(KG.Lv1) end
                end
            end

            if #active == 0 and not upkgSlot
               and #upkgQueue == 0 and #upkgChecks == 0 and #requeue == 0 then
                break
            end
        end

        KG.ActivePhases = {}
        for _, t in ipairs(active) do pcall(function() unequipPet(t.uuid) end) end
        if upkgSlot then pcall(function() unequipPet(upkgSlot.uuid) end) end

        if KG.Running then
            KG.Running = false
            KG.AllDone = true
            unequipAllActive()
            task.wait(0.5)
            KG.Thread = nil
            KG.CompletedNaturally = true
            pcall(function() if tglKGStart then tglKGStart:SetState(false) end end)
            win:luluNotify("Automatelly Up Kg Done All Done", "success")
            if Webhook.KG then
                sendWebhookEmbed({
                    title       = "Automatelly Up KG Done!",
                    description = "Semua **" .. #KG.Targets .. " pets** selesai Up KG.",
                    color       = 0x57F287,
                    footer      = { text = "LuluXGAG " .. SCRIPT_VERSION },
                    timestamp   = os.date("!%Y-%m-%dT%H:%M:%S"),
                })
            end
            if LV.FromKG or LV.WaitingForKG then
                LV.WaitingForKG = false
                if not LV.Running then
                    LV.Running = true
                    LV.AllDone = false
                end
                task.spawn(triggerLVAfterKG)
            end
        end
    end)
end

