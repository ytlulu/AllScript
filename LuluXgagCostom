local function findBoostTool(toyType)
    for _, item in ipairs(Backpack:GetChildren()) do
        if item:IsA("Tool")
            and string.find(item.Name, toyType .. " Pet Toy")
            and string.find(item.Name, "Passive Boost") then
            return item
        end
    end
    return nil
end

local function applyOneToy(uuid, toyType)
    local tool = findBoostTool(toyType)
    if not tool then return false end
    local char = LP.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    pcall(function()
        hum:EquipTool(tool)
        task.wait(0.3)
        ReplicatedStorage.GameEvents.PetBoostService:FireServer("ApplyBoost", uuid)
        task.wait(0.3)
        hum:UnequipTools()
        task.wait(0.3)
    end)
    return true
end

local function applyBoostDirect(uuid)
    local useSmall  = (boost.ToyMode == "Small"  or boost.ToyMode == "Both")
    local useMedium = (boost.ToyMode == "Medium" or boost.ToyMode == "Both")
    if useSmall  and findBoostTool("Small")  then applyOneToy(uuid, "Small")  end
    if useMedium and findBoostTool("Medium") then applyOneToy(uuid, "Medium") end
end

local function doScanBoostPets()
    boost.ScanMap  = {}
    boost.Displays = {}
    pcall(function()
        local seen = {}
        local i    = 0
        for _, child in ipairs(getPetDisplay():GetChildren()) do
            if child:IsA("Frame") and child:FindFirstChild("Main") then
                i = i + 1
                local m       = child.Main
                local petName = m:FindFirstChild("PET_NAME") and m.PET_NAME.Text or ""
                local petType = m:FindFirstChild("PET_TYPE") and m.PET_TYPE.Text or ""
                local base
                if petName ~= "" and petType ~= "" then
                    base = petName .. " [" .. petType .. "]"
                elseif petName ~= "" then
                    base = petName
                elseif petType ~= "" then
                    base = petType
                else
                    base = "Pet #" .. i
                end
                local key = base
                local n   = 2
                while seen[key] do key = base .. " (" .. n .. ")"; n = n + 1 end
                seen[key]          = true
                boost.ScanMap[key] = child.Name
                table.insert(boost.Displays, key)
            end
        end
    end)
    return #boost.Displays
end

local function startBoostLoop()
    boost.Thread = task.spawn(function()
        while boost.Running do
            task.wait(boost.TICK)
            if not boost.Running then break end

            local useSmall  = (boost.ToyMode == "Small"  or boost.ToyMode == "Both")
            local useMedium = (boost.ToyMode == "Medium" or boost.ToyMode == "Both")

            for uuid, timers in pairs(boost.Timers) do
                if not boost.Running then break end

                if useSmall then
                    timers.st = timers.st - boost.TICK
                    if timers.st <= 0 then
                        if findBoostTool("Small") then
                            timers.st = boost.Duration
                            pcall(function() applyOneToy(uuid, "Small") end)
                        else
                            timers.st = 0
                        end
                    end
                end

                if useMedium then
                    timers.mt = timers.mt - boost.TICK
                    if timers.mt <= 0 then
                        if findBoostTool("Medium") then
                            timers.mt = boost.Duration
                            pcall(function() applyOneToy(uuid, "Medium") end)
                        else
                            timers.mt = 0
                        end
                    end
                end
            end
        end
        boost.Thread = nil
    end)
end

