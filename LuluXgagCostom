tabMain:Accordion("Auto Leveling", function(sec)
    ddLVTarget = sec:MultiDropdown("Select Pets", allDisplay, {}, function(sel)
        lvManualTargets = sel
    end)

    sec:NumberInput("Target Count", lvMany, 1, 1, 7, function(v)
        lvMany = v; saveSettings()
    end)

    sec:NumberInput("Target Level", lvTargetAge, 1, 10, 100, function(v)
        lvTargetAge = v; saveSettings()
    end)

    ddLVLv1 = sec:Dropdown("Leveling 1", getConfigsByType("leveling lv 1"), "", function(sel)
        lvLv1 = getConfigUUIDs("leveling lv 1", sel)
    end)

    ddLVLv2 = sec:Dropdown("Leveling 2", getConfigsByType("leveling lv 2"), "", function(sel)
        lvLv2 = getConfigUUIDs("leveling lv 2", sel)
    end)

    sec:Toggle("Auto Select from KG", lvFromKG, function(on)
        lvFromKG = on; saveSettings()
    end)

    tglLVStart = sec:Toggle("Start Auto Leveling", false, function(on)
        if on then
            lvAllDone             = false
            lvDoneUUIDs           = {}
            lvStatus              = {}
            allProgressLastStatus = ""

            -- Kumpulkan manual targets dari dropdown
            local seen, merged = {}, {}
            for _, dn in ipairs(lvManualTargets) do
                local p = petOf(dn)
                if p and not seen[p.uuid] then
                    seen[p.uuid] = true; table.insert(merged, dn)
                end
            end

            if lvFromKG then
                -- =============================================
                -- STANDBY MODE: tunggu Auto KG selesai dulu
                -- =============================================
                lvRunning      = false
                lvWaitingForKG = true
                lvTargets      = merged   -- sementara hanya dari LV list
                for _, dn in ipairs(lvTargets) do
                    local p = petOf(dn); if p then lvStatus[p.uuid] = "waiting" end
                end
                -- Kalau KG sudah running, langsung update standby list (LV+KG)
                if kgRunning then
                    local seenKG = {}
                    for _, dn in ipairs(lvTargets) do
                        local p = petOf(dn); if p then seenKG[p.uuid] = true end
                    end
                    for _, dn in ipairs(kgTargets) do
                        local p = petOf(dn)
                        if p and not seenKG[p.uuid] then
                            seenKG[p.uuid] = true; table.insert(lvTargets, dn)
                            lvStatus[p.uuid] = "waiting"
                        end
                    end
                end
                win:luluNotify(
                    "LV Standby – menunggu KG selesai | " .. #lvTargets .. " pets",
                    "info"
                )
            else
                -- =============================================
                -- NORMAL MODE: langsung start tanpa tunggu KG
                -- =============================================
                lvRunning      = true
                lvWaitingForKG = false
                lvTargets      = merged
                for _, dn in ipairs(lvTargets) do
                    local p = petOf(dn); if p then lvStatus[p.uuid] = "waiting" end
                end
                if #lvTargets == 0 then
                    lvRunning = false
                    pcall(function() if tglLVStart then tglLVStart:SetState(false) end end)
                    win:luluNotify("LV: tidak ada target – pilih pet di dropdown!", "warning")
                else
                    task.spawn(function() notifyLVStarted(lvTargets, lvTargetAge) end)
                    lvStartLoop()
                end
            end
        else
            -- STOP / matiin toggle
            lvRunning      = false
            lvWaitingForKG = false
            pcall(function() if lvThread then task.cancel(lvThread) end end)
            lvThread              = nil
            allProgressLastStatus = ""
            task.spawn(function()
                unequipAllActive(); task.wait(0.5); refreshTargets()
            end)
        end
    end)
end)

